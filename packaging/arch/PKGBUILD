# Arch Linux 包：直接用 GitHub Release 里的 linux-x64 单文件包，程序装到 /opt/can-downloader。
# CI（.github/workflows/build.yml 的 arch 任务）每次发版填好 pkgver 和 sha256sums、打出
# can-downloader-bin-*.pkg.tar.zst，并把填好的 PKGBUILD 一起挂到 Release；也可以拿它去发 AUR。
#
# /opt 不可写：数据、日志、下载缓存和默认安装目录放 ~/.local/share/CAN Downloader；
# 下载器不自己更新，用 pacman（或 AUR 助手）更新。

pkgname=can-downloader-bin
pkgver=3.0.2
pkgrel=1
pkgdesc="CAN 下载器：安装、更新 CAN 连飞网络的客户端"
arch=('x86_64')
url="https://github.com/JianyueLab-Org/can-downloader"
license=('LicenseRef-can-downloader')
# .NET 运行时要 glibc / libstdc++ / ICU；Avalonia 走 X11（Wayland 下经 XWayland），Skia 要 fontconfig / freetype
depends=('glibc' 'gcc-libs' 'zlib' 'icu' 'fontconfig' 'freetype2'
         'libx11' 'libice' 'libsm' 'libxi' 'libxcursor' 'libxrandr' 'libxext')
optdepends=('noto-fonts-cjk: 界面中文字体（没装任何中文字体时显示成方框）'
            'xdg-utils: 登录时打开浏览器、打开文件夹'
            'xorg-xwayland: Wayland 桌面下运行')
provides=('can-downloader')
conflicts=('can-downloader')
# 单文件程序的托管部分附在 ELF 后面，strip 会把它截掉
options=('!strip' '!debug')
source=("CAN-Downloader-${pkgver}-linux-x64.tar.gz::${url}/releases/download/v${pkgver}/CAN-Downloader-${pkgver}-linux-x64.tar.gz")
sha256sums=('SKIP')

package() {
  install -Dm755 "${srcdir}/can-downloader/Downloader" "${pkgdir}/opt/can-downloader/Downloader"

  # 用包装脚本而不是软链：下载器按程序文件所在目录判断数据放哪
  install -d "${pkgdir}/usr/bin"
  printf '#!/bin/sh\nexec /opt/can-downloader/Downloader "$@"\n' > "${pkgdir}/usr/bin/can-downloader"
  chmod 755 "${pkgdir}/usr/bin/can-downloader"

  install -Dm644 "${srcdir}/can-downloader/can-downloader.desktop" "${pkgdir}/usr/share/applications/can-downloader.desktop"
}
