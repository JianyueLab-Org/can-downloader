<Project>
  <!--
    Linux 单文件发布：dotnet publish src/Downloader -p:PublishProfile=linux-arm64，输出 publish/linux-arm64/Downloader。
    packaging/build.sh 打成通用 tar.gz（任何 glibc 发行版解压即用）。
  -->
  <PropertyGroup>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <Import Project="SingleFile.props" />
</Project>
