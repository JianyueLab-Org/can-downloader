<Project>
  <!--
    macOS 单文件发布：dotnet publish src/Downloader -p:PublishProfile=osx-arm64，输出 publish/osx-arm64/Downloader。
    发布包是 Apple Silicon 和 Intel 通用的 CAN Downloader.app：packaging/build.sh 在 macOS 上分别发布 osx-arm64 与 osx-x64 后合成。
  -->
  <PropertyGroup>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <Import Project="SingleFile.props" />
</Project>
