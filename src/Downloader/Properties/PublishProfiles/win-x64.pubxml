<Project>
  <!--
    单文件发布：dotnet publish src/Downloader -p:PublishProfile=win-x64
    输出 publish/win-x64/Downloader.exe 一个文件：自包含（不需要安装 .NET），原生库（Skia、HarfBuzz、ANGLE）
    也打包在内，首次运行时解压到临时目录。数据、日志、下载缓存、默认安装目录都在 exe 所在目录下。
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>

  <!-- SkiaSharp / HarfBuzz 包自带的原生调试符号（100 MB 以上）不发布；本程序的符号已嵌入 exe -->
  <Target Name="ExcludeNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
