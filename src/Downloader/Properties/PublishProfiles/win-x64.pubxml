<Project>
  <!--
    Windows 单文件发布：dotnet publish src/Downloader -p:PublishProfile=win-x64
    输出 publish/win-x64/Downloader.exe 一个文件。数据、日志、下载缓存、默认安装目录都在 exe 所在目录下。
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <Import Project="SingleFile.props" />
</Project>
