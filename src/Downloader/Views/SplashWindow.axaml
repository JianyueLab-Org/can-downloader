<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Downloader.ViewModels"
        x:Class="Downloader.Views.SplashWindow"
        x:DataType="vm:SelfUpdateViewModel"
        Title="CAN 下载器"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        BorderBrush="{DynamicResource Brush.Border.Control}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen">
  <!--
    启动窗口：打开下载器时先检查下载器自身的更新。
    ┌──────────────────────────────────────────┐
    │ [CAN] CAN 下载器                       ✕ │
    │       版本 1.1.0                          │
    ├──────────────────────────────────────────┤
    │ 正在检查更新…                             │   检查中 / 已是最新 / 下载中 / 安装中 / 失败
    │ ▓▓▓▓▓▓░░░░░░░░░░░░░░░                    │
    │ 正在获取更新清单                          │
    ├──────────────────────────────────────────┤
    │ 发现新版本  1.1.0 → 1.2.0                 │   有新版本：更新说明 + 稍后 / 立即更新
    │ · …                                       │
    │                       [稍后] [立即更新]   │
    └──────────────────────────────────────────┘
    完成后进入登录窗口（LoginWindow）；检查失败时可选离线模式，跳过登录。
    拖动任意空白处移动窗口。
  -->
  <Border PointerPressed="OnPointerPressed" Background="{DynamicResource Brush.Bg.App}">
    <StackPanel>
      <!-- ===== 标识 ===== -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,18,8,16">
        <Border Classes="logo">
          <TextBlock Text="CAN" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="appName" Text="{Binding AppName}" />
          <TextBlock Classes="caption mono"><Run Text="版本 " /><Run Text="{Binding CurrentVersion}" /></TextBlock>
        </StackPanel>
        <Button Grid.Column="2" Classes="ghost icon danger" Content="✕" VerticalAlignment="Top"
                ToolTip.Tip="退出" Click="OnCloseClick" />
      </Grid>

      <!-- ===== 检查 / 下载 / 安装 / 失败 ===== -->
      <Border Classes="splashBody" IsVisible="{Binding ShowStatus}">
        <StackPanel Spacing="8">
          <TextBlock Classes="splashStatus" Classes.failed="{Binding IsFailed}" Text="{Binding StatusText}" />
          <ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding Progress}" Maximum="100"
                       IsVisible="{Binding ShowProgress}" />
          <TextBlock Classes="caption mono" Text="{Binding DetailText}" TextWrapping="Wrap" MinHeight="15" />
        </StackPanel>
      </Border>

      <!-- ===== 有新版本 ===== -->
      <Border Classes="splashBody" IsVisible="{Binding IsAvailable}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="splashStatus" Text="发现新版本" />
            <TextBlock Classes="versionArrow" VerticalAlignment="Center"><Run Text="{Binding CurrentVersion}" /><Run Classes="dim" Text="  →  " /><Run Classes="new" Text="{Binding LatestVersion}" /></TextBlock>
          </StackPanel>
          <TextBlock Classes="caption" Text="{Binding ReleaseInfo}" />
          <Border Classes="notes">
            <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="14,*" Margin="0,2">
                      <TextBlock Classes="muted" Text="·" />
                      <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <TextBlock Classes="caption" Foreground="{DynamicResource Brush.State.Update}" IsVisible="{Binding IsMandatory}"
                     Text="这是必需更新，旧版本将无法获取软件列表。" />
          <TextBlock Classes="caption" Foreground="{DynamicResource Brush.State.Error}" TextWrapping="Wrap"
                     Text="{Binding UpdateErrorText}" IsVisible="{Binding HasUpdateError}" />
        </StackPanel>
      </Border>

      <!-- ===== 底部按钮 ===== -->
      <Border Classes="footer" IsVisible="{Binding IsAvailable}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Space.Sm}">
          <Button Content="稍后" MinWidth="72" IsVisible="{Binding !IsMandatory}" Command="{Binding SkipCommand}"
                  ToolTip.Tip="使用当前版本进入，之后可在主界面更新" />
          <Button Classes="primary" Content="立即更新" MinWidth="72" Command="{Binding UpdateNowCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="footer" IsVisible="{Binding IsDownloading}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消" MinWidth="72" Command="{Binding CancelDownloadCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="footer" IsVisible="{Binding IsFailed}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Space.Sm}">
          <Button Content="离线模式" MinWidth="72" Command="{Binding ContinueOfflineCommand}"
                  ToolTip.Tip="不登录进入：只显示上次缓存的软件列表，不能下载或更新" />
          <Button Classes="primary" Content="重试" MinWidth="72" Command="{Binding RetryCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
