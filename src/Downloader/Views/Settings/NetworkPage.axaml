<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Downloader.ViewModels"
             x:Class="Downloader.Views.Settings.NetworkPage"
             x:DataType="vm:SettingsViewModel">
  <!-- 网络：代理、超时 -->
  <StackPanel Width="340" HorizontalAlignment="Left">
    <TextBlock Classes="label" Text="代理" />
    <ComboBox ItemsSource="{Binding ProxyModes}" SelectedItem="{Binding ProxyMode}" HorizontalAlignment="Stretch" />

    <Grid ColumnDefinitions="*,96" ColumnSpacing="{DynamicResource Space.Sm}" RowDefinitions="Auto,Auto"
          IsEnabled="{Binding IsCustomProxy}">
      <TextBlock Classes="label" Text="地址" />
      <TextBlock Grid.Column="1" Classes="label" Text="端口" />
      <TextBox Grid.Row="1" Classes="mono" Text="{Binding ProxyHost}" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="65535" Increment="1" FormatString="0"
                     Value="{Binding ProxyPort}" />
    </Grid>

    <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock Classes="muted" VerticalAlignment="Center" Text="连接超时（秒）" />
      <NumericUpDown Grid.Column="1" Width="96" Minimum="5" Maximum="120" Increment="5" FormatString="0"
                     Value="{Binding TimeoutSeconds}" />
    </Grid>
  </StackPanel>
</UserControl>
