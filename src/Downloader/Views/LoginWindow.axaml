<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Downloader.ViewModels"
        x:Class="Downloader.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="登录 - CAN 下载器"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        BorderBrush="{DynamicResource Brush.Border.Control}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen">
  <!--
    登录窗口：启动窗口检查完下载器更新后显示。登录后才能进入主界面；也可以离线模式进入。
    ┌──────────────────────────────────────────┐
    │ [CAN] CAN 下载器                       ✕ │
    │       版本 1.1.0                          │
    ├──────────────────────────────────────────┤
    │▌CAN 下载器 1.2.0 已发布        [立即更新] │  启动时选了“稍后”才显示
    ├──────────────────────────────────────────┤
    │ CAN ID   [1234567                     ]   │
    │ 密码     [••••••                      ]   │
    │ [✓] 记住账号  [ ] 自动登录                │
    │ [               登录                  ]   │
    ├──────────────────────────────────────────┤
    │ 注册账号  忘记密码              [离线模式] │
    └──────────────────────────────────────────┘
    拖动任意空白处移动窗口。
  -->
  <Border PointerPressed="OnPointerPressed" Background="{DynamicResource Brush.Bg.App}">
    <StackPanel>
      <!-- ===== 标识 ===== -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,18,8,16">
        <Border Classes="logo">
          <TextBlock Text="CAN" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="appName" Text="{Binding AppName}" />
          <TextBlock Classes="caption mono"><Run Text="版本 " /><Run Text="{Binding CurrentVersion}" /></TextBlock>
        </StackPanel>
        <Button Grid.Column="2" Classes="ghost icon danger" Content="✕" VerticalAlignment="Top"
                ToolTip.Tip="退出" Click="OnCloseClick" />
      </Grid>

      <!-- ===== 登录前更新下载器 ===== -->
      <Border Classes="notice update loginNotice" IsVisible="{Binding HasLauncherUpdate}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Border Classes="noticeMark" />
          <TextBlock Grid.Column="1" Text="{Binding LauncherUpdateText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="small" Content="立即更新" Command="{Binding UpdateLauncherCommand}" />
        </Grid>
      </Border>

      <!-- ===== 账号 ===== -->
      <StackPanel Margin="20,14,20,20" IsEnabled="{Binding IsIdle}">
        <TextBlock Classes="label" Text="CAN ID" />
        <TextBox x:Name="CanIdBox" Classes="mono" Text="{Binding CanId}" PlaceholderText="数字账号" MaxLength="10" />
        <TextBlock Classes="label" Text="密码" />
        <TextBox x:Name="PasswordBox" Classes="mono" Text="{Binding Password}" PasswordChar="•" PlaceholderText="CAN 网络密码" />

        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
          <CheckBox Content="记住账号" IsChecked="{Binding RememberAccount}" />
          <CheckBox Content="自动登录" IsChecked="{Binding AutoLogin}" ToolTip.Tip="下次启动检查完更新后自动登录" />
        </StackPanel>

        <TextBlock Classes="caption" Margin="0,6,0,0" Foreground="{DynamicResource Brush.State.Error}"
                   TextWrapping="Wrap" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" />

        <Button Classes="primary loginButton" Margin="0,12,0,0" IsDefault="True"
                Content="{Binding LoginButtonText}" Command="{Binding LoginCommand}" />
      </StackPanel>

      <!-- ===== 底部 ===== -->
      <Border Classes="footer">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="2">
          <Button Classes="ghost small" Content="注册账号" ToolTip.Tip="界面原型：将在浏览器中打开 CAN 账号注册页" />
          <Button Grid.Column="1" Classes="ghost small" Content="忘记密码" ToolTip.Tip="界面原型：将在浏览器中打开密码重置页" />
          <Button Grid.Column="3" Content="离线模式" Command="{Binding ContinueOfflineCommand}"
                  ToolTip.Tip="不登录进入：只显示上次缓存的软件列表，不能下载或更新" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</Window>
