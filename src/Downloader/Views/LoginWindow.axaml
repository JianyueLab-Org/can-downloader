<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Downloader.ViewModels"
        x:Class="Downloader.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="登录 - CAN 下载器"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        BorderBrush="{DynamicResource Brush.Border.Control}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen">
  <!--
    登录窗口：启动窗口检查完下载器更新后显示。登录后才能进入主界面；也可以离线模式进入。
    ┌──────────────────────────────────────────┐
    │ [CAN] CAN 下载器                       ✕ │
    │       版本 1.1.0                          │
    ├──────────────────────────────────────────┤
    │▌CAN 下载器 1.2.0 已发布        [立即更新] │  有新版本时才显示
    ├──────────────────────────────────────────┤
    │ CAN ID 或邮箱 [1234567                 ]  │
    │ 密码          [••••••                  ]  │  验证码登录时：[验证码][发送验证码]
    │ [✓] 记住账号 [ ] 自动登录  改用邮箱验证码登录 │
    │ [               登录                  ]   │
    ├──────────────────────────────────────────┤
    │ 注册账号  忘记密码              [离线模式] │  注册 / 忘记密码在浏览器中打开 ceruleanavi.net
    └──────────────────────────────────────────┘
    拖动任意空白处移动窗口。
  -->
  <Border PointerPressed="OnPointerPressed" Background="{DynamicResource Brush.Bg.App}">
    <StackPanel>
      <!-- ===== 标识 ===== -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,18,8,16">
        <Border Classes="logo">
          <TextBlock Text="CAN" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="appName" Text="{Binding AppName}" />
          <TextBlock Classes="caption mono"><Run Text="版本 " /><Run Text="{Binding CurrentVersion}" /></TextBlock>
        </StackPanel>
        <Button Grid.Column="2" Classes="ghost icon danger" Content="✕" VerticalAlignment="Top"
                ToolTip.Tip="退出" Click="OnCloseClick" />
      </Grid>

      <!-- ===== 登录前更新下载器 ===== -->
      <Border Classes="notice update loginNotice" IsVisible="{Binding HasLauncherUpdate}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Border Classes="noticeMark" />
          <TextBlock Grid.Column="1" Text="{Binding LauncherUpdateText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="small" Content="立即更新" Command="{Binding UpdateLauncherCommand}" />
        </Grid>
      </Border>

      <!-- ===== 账号 ===== -->
      <StackPanel Margin="20,14,20,20" IsEnabled="{Binding IsIdle}">
        <TextBlock Classes="label" Text="CAN ID 或邮箱" />
        <TextBox x:Name="CanIdBox" Classes="mono" Text="{Binding CanId}" PlaceholderText="CAN ID 或注册邮箱" />

        <!-- 密码登录 -->
        <StackPanel IsVisible="{Binding IsPasswordMode}">
          <TextBlock Classes="label" Text="密码" />
          <TextBox x:Name="PasswordBox" Classes="mono" Text="{Binding Password}" PasswordChar="•" PlaceholderText="CAN 账号密码" />
        </StackPanel>

        <!-- 邮箱验证码登录 -->
        <StackPanel IsVisible="{Binding IsCodeMode}">
          <TextBlock Classes="label" Text="邮箱验证码" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space.Sm}">
            <TextBox x:Name="CodeBox" Classes="mono" Text="{Binding Code}" PlaceholderText="邮件中的 6 位验证码" MaxLength="6" />
            <Button Grid.Column="1" MinWidth="96" Content="{Binding SendCodeText}" Command="{Binding SendCodeCommand}" />
          </Grid>
          <TextBlock Classes="caption" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding CodeHintText}" IsVisible="{Binding HasCodeHint}" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16" Margin="0,8,0,0">
          <CheckBox Content="记住账号" IsChecked="{Binding RememberAccount}" />
          <CheckBox Grid.Column="1" Content="自动登录" IsChecked="{Binding AutoLogin}" ToolTip.Tip="下次启动检查完更新后自动登录（会话保存在本机）" />
          <Button Grid.Column="3" Classes="ghost small" Content="{Binding SwitchModeText}" Command="{Binding SwitchModeCommand}" />
        </Grid>

        <TextBlock Classes="caption" Margin="0,6,0,0" Foreground="{DynamicResource Brush.State.Error}"
                   TextWrapping="Wrap" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" />

        <Button Classes="primary loginButton" Margin="0,12,0,0" IsDefault="True"
                Content="{Binding LoginButtonText}" Command="{Binding LoginCommand}" />
      </StackPanel>

      <!-- ===== 底部 ===== -->
      <Border Classes="footer">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="2">
          <Button Classes="ghost small" Content="注册账号" Command="{Binding OpenSignUpCommand}" ToolTip.Tip="在浏览器中打开 CAN 账号注册页" />
          <Button Grid.Column="1" Classes="ghost small" Content="忘记密码" Command="{Binding OpenResetPasswordCommand}" ToolTip.Tip="在浏览器中打开密码重置页" />
          <Button Grid.Column="3" Content="离线模式" Command="{Binding ContinueOfflineCommand}"
                  ToolTip.Tip="不登录进入：只显示上次缓存的软件列表，不能下载或更新" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</Window>
