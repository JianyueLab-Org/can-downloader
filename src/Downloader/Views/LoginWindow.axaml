<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Downloader.ViewModels"
        x:Class="Downloader.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="登录 - CAN 下载器"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        BorderBrush="{DynamicResource Brush.Border.Control}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen">
  <!--
    登录窗口：启动窗口检查完下载器更新后显示，登录后才能进入主界面。
    ┌──────────────────────────────────────────┐
    │ [CAN] CAN 下载器                       ✕ │
    │       版本 3.0.1                          │
    ├──────────────────────────────────────────┤
    │▌CAN 下载器 3.0.2 已发布        [立即更新] │  有新版本时才显示
    ├──────────────────────────────────────────┤
    │ 使用 CAN 账号登录。点击下方按钮会在浏览器 │
    │ 中打开 CAN 网站，登录并授权后自动回到这里 │
    │ [✓] 自动登录                              │
    │ [          使用 CAN 账号登录           ]  │  等待授权时显示状态与 [取消]
    ├──────────────────────────────────────────┤
    │ 没有账号？[注册账号]                      │
    └──────────────────────────────────────────┘
    OAuth 登录（Services/OAuthLogin.cs），下载器不接触密码。拖动任意空白处移动窗口。
  -->
  <Border PointerPressed="OnPointerPressed" Background="{DynamicResource Brush.Bg.App}">
    <StackPanel>
      <!-- ===== 标识 ===== -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,18,8,16">
        <Image Classes="logo" Source="/Assets/app-logo.png" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="appName" Text="{Binding AppName}" />
          <TextBlock Classes="caption mono"><Run Text="版本 " /><Run Text="{Binding CurrentVersion}" /></TextBlock>
        </StackPanel>
        <Button Grid.Column="2" Classes="ghost icon danger" Content="✕" VerticalAlignment="Top"
                ToolTip.Tip="退出" Click="OnCloseClick" />
      </Grid>

      <!-- ===== 登录前更新下载器 ===== -->
      <Border Classes="notice update loginNotice" IsVisible="{Binding HasLauncherUpdate}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Border Classes="noticeMark" />
          <TextBlock Grid.Column="1" Text="{Binding LauncherUpdateText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="small" Content="立即更新" Command="{Binding UpdateLauncherCommand}" />
        </Grid>
      </Border>

      <!-- ===== 登录 ===== -->
      <StackPanel Margin="20,14,20,20" Spacing="10">
        <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="20"
                   Text="使用 CAN 账号登录。点击下方按钮会在浏览器中打开 CAN 网站，登录并授权后自动回到下载器。" />

        <CheckBox Content="自动登录" IsChecked="{Binding AutoLogin}" IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="下次启动时自动登录。授权保存在本机，可在 CAN 网站的「已授权应用」中随时撤销" />

        <TextBlock Classes="caption" Foreground="{DynamicResource Brush.State.Error}"
                   TextWrapping="Wrap" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" />

        <!-- 等待浏览器授权 -->
        <StackPanel Spacing="8" IsVisible="{Binding IsBusy}">
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StatusText}" />
          <ProgressBar IsIndeterminate="True" />
        </StackPanel>

        <Button Classes="primary loginButton" IsDefault="True" Content="使用 CAN 账号登录"
                Command="{Binding LoginCommand}" IsVisible="{Binding IsIdle}" />
        <Button Classes="loginButton" Content="取消" Command="{Binding CancelLoginCommand}" IsVisible="{Binding IsBusy}" />
      </StackPanel>

      <!-- ===== 底部 ===== -->
      <Border Classes="footer">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Classes="caption" VerticalAlignment="Center" Text="没有账号？" />
          <Button Classes="ghost small" Content="注册账号" Command="{Binding OpenSignUpCommand}" ToolTip.Tip="在浏览器中打开 CAN 账号注册页" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
