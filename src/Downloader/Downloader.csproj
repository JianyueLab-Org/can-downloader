<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>Downloader</AssemblyName>
    <RootNamespace>Downloader</RootNamespace>
    <!-- 下载器版本号：唯一的来源，界面、日志、User-Agent 都从程序集读取；发布 tag 为 v<版本号> -->
    <Version>3.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <!--
    软件库的显示信息（分类、名称、简介），软件列表本身来自 CAN API。嵌入 exe（单文件发布只有一个 exe）；
    编译输出目录里另有一份，exe 旁边有 catalog.json 时优先使用，修改后点“检查更新”即生效。
  -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/app.ico" />
    <AvaloniaResource Include="Assets/app-logo.png" />
    <EmbeddedResource Include="Assets/catalog.json" LogicalName="catalog.json" />
    <None Include="Assets/catalog.json" Link="catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
